generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ALUNO
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
}

enum RequerimentoStatus {
  ABERTO
  EM_ANALISE
  DEFERIDO
  INDEFERIDO
}

enum RequerimentoTipo {
  RECEBIMENTO_PROVA
  APROVEITAMENTO_ESTUDOS
  TRANCAMENTO
  OUTRO
}

enum OcorrenciaTipo {
  ACADEMICO
  ATENDIMENTO
  INFRAESTRUTURA
  SISTEMA
  OUTRO
}

enum OcorrenciaStatus {
  ABERTA
  EM_ANDAMENTO
  RESOLVIDA
}

enum KnowledgeDocumentType {
  PDF
  TEXT
  LINK
  FAQ
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  email     String   @unique
  senha     String
  matricula String?  @unique
  RA        String?  @unique
  role      UserRole @default(ALUNO)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  requerimentos Requerimento[]
  ocorrencias   Ocorrencia[]
}

model Conversation {
  id       String    @id @default(uuid()) @db.Uuid
  titulo   String?
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  requerimentoPendenteTipo      RequerimentoTipo?
  requerimentoPendenteDescricao String?           @db.Text

  ocorrenciaPendenteTitulo    String?
  ocorrenciaPendenteDescricao String?         @db.Text
  ocorrenciaPendenteTipo      OcorrenciaTipo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  content        String       @db.Text
  role           MessageRole
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Requerimento {
  id        String             @id @default(uuid()) @db.Uuid
  protocolo String             @unique
  tipo      RequerimentoTipo
  descricao String             @db.Text
  status    RequerimentoStatus @default(ABERTO)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ocorrencia {
  id        String           @id @default(uuid()) @db.Uuid
  titulo    String
  descricao String           @db.Text
  tipo      OcorrenciaTipo
  status    OcorrenciaStatus @default(ABERTA)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeDocument {
  id          String                  @id @default(uuid()) @db.Uuid
  title       String
  description String?                 @db.Text
  type        KnowledgeDocumentType
  status      KnowledgeDocumentStatus @default(PENDING)

  sourceUrl    String? @db.Text
  storagePath  String? @db.Text
  originalName String?
  mimeType     String?

  chunks KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
}

model KnowledgeChunk {
  id         String @id @default(uuid()) @db.Uuid
  content    String @db.Text
  chunkIndex Int

  page     Int?
  metadata Json?

  // Embedding gerado pelo Gemini
  embedding Unsupported("vector(768)")?

  documentId String            @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}
