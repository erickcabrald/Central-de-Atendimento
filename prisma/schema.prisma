generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ALUNO
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  email     String   @unique
  senha     String
  matricula String?  @unique
  RA        String?  @unique
  role      UserRole @default(ALUNO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
